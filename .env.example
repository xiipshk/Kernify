# RTK - Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# DJANGO CORE SETTINGS
# ========================================
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production

# Set to False in production!
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# ========================================
# DATABASE
# ========================================
# SQLite (development)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (production) - uncomment and configure:
# DATABASE_URL=postgres://user:password@localhost:5432/rtk

# Database connection options (optional)
# DATABASE_CONN_MAX_AGE=60
# DATABASE_CONN_HEALTH_CHECKS=True

# ========================================
# REDIS (Caching, Sessions, Celery)
# ========================================
REDIS_URL=redis://localhost:6379/0

# ========================================
# EMAIL SETTINGS
# ========================================
# Console backend for development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP settings (production) - uncomment and configure:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=RTK <noreply@rtk.example.com>

# ========================================
# AI PROVIDERS (Optional)
# ========================================
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_ORG_ID=org-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=...

# Local AI (Ollama, LM Studio, etc.)
# LOCAL_AI_URL=http://localhost:11434
# LOCAL_AI_MODEL=llama3

# Default AI provider for each feature
# AI_DEFAULT_CHAT_PROVIDER=openai
# AI_DEFAULT_REVIEW_PROVIDER=anthropic
# AI_DEFAULT_EXPLAIN_PROVIDER=openai
# AI_DEFAULT_GENERATE_PROVIDER=openai

# ========================================
# STATIC & MEDIA FILES (Production)
# ========================================
# AWS S3 / DigitalOcean Spaces / Cloudflare R2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=
# AWS_S3_OBJECT_PARAMETERS={"CacheControl": "max-age=86400"}
# AWS_DEFAULT_ACL=public-read
# AWS_LOCATION=static

# Media files
# MEDIA_URL=https://your-bucket.s3.amazonaws.com/media/

# ========================================
# SECURITY (Production)
# ========================================
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# ========================================
# CORS (if using separate frontend)
# ========================================
# CORS_ALLOWED_ORIGINS=https://your-frontend.com,http://localhost:3000
# CORS_ALLOW_CREDENTIALS=True

# ========================================
# LOGGING
# ========================================
# LOG_LEVEL=INFO
# LOG_FILE=logs/rtk.log

# ========================================
# CELERY (Background Tasks)
# ========================================
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# CELERY_TASK_ALWAYS_EAGER=False

# ========================================
# INTERNATIONALIZATION
# ========================================
# LANGUAGE_CODE=en-us
# TIME_ZONE=UTC
# USE_I18N=True
# USE_TZ=True

# ========================================
# MONITORING (Optional)
# ========================================
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
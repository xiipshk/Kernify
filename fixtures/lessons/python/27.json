      "type": "heading",
      "level": 2,
      "content": "Типичные ошибки"
    },
    {
      "type": "table",
      "headers": [
        "Ошибка",
        "Правильно"
      ],
      "rows": [
        [
          "Запуск контейнера от root",
          "`USER appuser` в Dockerfile"
        ],
        [
          "Нет health checks",
          "livenessProbe + readinessProbe"
        ],
        [
          "Хардкод секретов в манифестах",
          "Secret / External Secrets Operator"
        ],
        [
          "Нет resource limits",
          "requests/limits на CPU и память"
        ],
        [
          "Один реплика в продакшене",
          "Минимум 3, HPA настроен"
        ],
        [
          "Отсутствие 롤лбэка",
          "Стратегия деплоя (RollingUpdate/Canary)"
        ]

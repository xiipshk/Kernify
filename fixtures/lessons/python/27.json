    {
      "type": "heading",
      "level": 2,
      "content": "4. Helm — пакетный менеджер k8s"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Структура чарта"
    },
    {
      "type": "code",
      "language": "text",
      "content": "myapp/\n├── Chart.yaml\n├── values.yaml\n├── templates/\n│   ├── deployment.yaml\n│   ├── service.yaml\n│   ├── ingress.yaml\n│   ├── configmap.yaml\n│   ├── secret.yaml\n│   └── hpa.yaml\n└── charts/"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Chart.yaml"
    },
    {
      "type": "code",
      "language": "yaml",
      "content": "apiVersion: v2\nname: myapp\ndescription: My Python Application\nversion: 1.2.3\nappVersion: \"1.2.3\"\nkeywords:\n  - python\n  - fastapi\nmaintainers:\n  - name: Dev Team\n    email: dev@example.com"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "values.yaml"
    },
    {
      "type": "code",
      "language": "yaml",
      "content": "replicaCount: 3\n\nimage:\n  repository: ghcr.io/user/myapp\n  tag: \"v1.2.3\"\n  pullPolicy: IfNotPresent\n\nservice:\n  type: ClusterIP\n  port: 80\n\ningress:\n  enabled: true\n  className: nginx\n  hosts:\n    - host: api.example.com\n      paths:\n        - path: /\n          pathType: Prefix\n  tls:\n    - secretName: myapp-tls\n      hosts:\n        - api.example.com\n\nresources:\n  limits:\n    cpu: 500m\n    memory: 512Mi\n  requests:\n    cpu: 250m\n    memory: 256Mi\n\nautoscaling:\n  enabled: true\n  minReplicas: 3\n  maxReplicas: 10\n  targetCPUUtilizationPercentage: 80\n\nenv:\n  - name: LOG_LEVEL\n    value: \"INFO\"\n  - name: WORKERS\n    value: \"4\"\n\nenvFromSecrets:\n  - name: myapp-secrets"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "HPA (Horizontal Pod Autoscaler)"
    },
    {
      "type": "code",
      "language": "yaml",
      "content": ""
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Установка"
    },
    {
      "type": "code",
      "language": "bash",
      "content": "helm repo add bitnami https://charts.bitnami.com/bitnami\nhelm dependency update ./myapp\nhelm install myapp ./myapp -n production --create-namespace\nhelm upgrade myapp ./myapp -n production"

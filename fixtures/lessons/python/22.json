      "content": "perf_counter — высокоточный таймер"
    },
    {
      "type": "code",
      "language": "python",
      "content": "import time\n\nstart = time.perf_counter()\nresult = heavy_computation()\nelapsed = time.perf_counter() - start\nprint(f\"Выполнено за {elapsed:.6f} сек\")"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Декоратор для тайминга"
    },
    {
      "type": "code",
      "language": "python",
      "content": "import functools\nimport time\n\ndef timer(func):\n    @functools.wraps(func)\n    def wrapper(*args, **kwargs):\n        start = time.perf_counter()\n        result = func(*args, **kwargs)\n        elapsed = time.perf_counter() - start\n        print(f\"{func.__name__}: {elapsed:.4f} сек\")\n        return result\n    return wrapper\n\n@timer\ndef slow_function():\n    time.sleep(1)"
    },

    {
      "type": "code",
      "language": "python",
      "content": "from multiprocessing import Pool\nimport time\n\ndef cpu_heavy(n):\n    return sum(i*i for i in range(n))\n\nif __name__ == \"__main__\":\n    with Pool(4) as pool:\n        results = pool.map(cpu_heavy, [10**6] * 4)"
    },

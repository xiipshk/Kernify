    },
    {
      "type": "code",
      "language": "python",
      "content": "def test_order_total():\n    order = Order()\n    order.add_item(UUID(...), 2, 10.0)\n    order.add_item(UUID(...), 1, 25.0)\n    assert order.total() == 45.0\n\ndef test_order_discount():\n    order = Order()\n    order.add_item(UUID(...), 10, 200.0)  # 2000\n    order.apply_discount(1000, 0.1)\n    assert order.total() == 1800.0"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Application тесты (с моками репозиториев)"

          "начало строки"
        ],
        [
          "`$`",
          "конец строки"
        ],
        [
          "`*`",
          "0 или более"
        ],
        [
          "`+`",
          "1 или более"
        ],
        [
          "`?`",
          "0 или 1"
        ],
        [
          "`{n,m}`",
          "от n до m раз"
        ],
        [
          "`[abc]`",
          "один из символов"
        ],
        [
          "`[^abc]`",
          "любой, КРОМЕ этих"
        ],
        [
          "`(...)`",
          "группа"
        ],

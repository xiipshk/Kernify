      "content": "line = 'Ivanov,Ivan,25,\"Moscow, Russia\"'\nimport csv\nreader = csv.reader([line])\nrow = next(reader)  # ['Ivanov', 'Ivan', '25', 'Moscow, Russia']"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Генерация slug для URL"
    },
    {
      "type": "code",
      "language": "python",
      "content": "import re\ndef slugify(text):\n    text = text.lower()\n    text = re.sub(r\"[^\\w\\s-]\", \"\", text)\n    text = re.sub(r\"[\\s_-]+\", \"-\", text)\n    return text.strip(\"-\")\n\nslugify(\"Привет, Мир!\")  # \"привет-мир\""
    },

    },
    {
      "type": "code",
      "language": "python",
      "content": "s = \"Python\"\n"
    },
    {
      "type": "heading",
      "level": 2,
      "content": "3. Основные методы строк"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Регистр"
    },
    {
      "type": "code",
      "language": "python",
      "content": "s = \"привет Мир\"\ns.upper()        # \"ПРИВЕТ МИР\"\ns.lower()        # \"привет мир\"\ns.capitalize()   # \"Привет мир\" (только первый)\ns.title()        # \"Привет Мир\" (каждое слово)\ns.swapcase()     # \"ПРИВЕТ мИР\""
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Поиск и проверка"
    },
    {
      "type": "code",
      "language": "python",
      "content": "s = \"hello world hello\"\n\ns.find(\"world\")      # 6 (индекс, -1 если нет)\ns.rfind(\"hello\")     # 12 (последнее вхождение)\ns.index(\"world\")     # 6 (ValueError если нет)\ns.count(\"hello\")     # 2\ns.startswith(\"hel\")  # True\ns.endswith(\"ld\")     # True\n\"world\" in s         # True (Pythonic)"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Замена и удаление"
    },
    {
      "type": "code",
      "language": "python",
      "content": "s = \"  hello world  \"\ns.strip()        # \"hello world\" (пробелы по краям)\ns.lstrip()       # \"hello world  \"\ns.rstrip()       # \"  hello world\"\ns.strip(\" h\")    # \"ello world\" (указанные символы)\n\ns = \"hello world\"\ns.replace(\"world\", \"Python\")     # \"hello Python\"\ns.replace(\"l\", \"L\", 1)           # \"heLlo world\" (только 1 замена)"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Разделение и объединение"
    },
    {
      "type": "code",
      "language": "python",
      "content": "s = \"apple,banana,cherry\"\nparts = s.split(\",\")          # ['apple', 'banana', 'cherry']\ns.split(\",\", 1)               # ['apple', 'banana,cherry'] (maxsplit)\n\" a b  c \".split()            # ['a', 'b', 'c'] (любые пробелы)\n\nlines = \"line1\\nline2\\nline3\".splitlines()  # ['line1', 'line2', 'line3']\n"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Другие полезные методы"
    },
    {
      "type": "code",
      "language": "python",
      "content": "s = \"hello\"\ns.center(10, \"-\")    # \"--hello---\" (по центру, заполнитель)\ns.ljust(10, \".\")     # \"hello.....\"\ns.rjust(10, \".\")     # \".....hello\"\ns.zfill(5)           # \"00hello\" (нули слева, для чисел)\n\n\"hello\".isalpha()    # True (только буквы)\n\"hello123\".isalnum() # True (буквы и цифры)\n\"123\".isdigit()      # True\n\"  \".isspace()       # True\n\"HELLO\".isupper()    # True\n\"\".isupper()         # False"
    },
    {
      "type": "heading",
      "level": 2,
      "content": "4. Форматирование строк"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "f-строки (Python 3.6+) — РЕКОМЕНДУЕМЫЙ способ"
    },
    {
      "type": "code",
      "language": "python",
      "content": "name = \"Анна\"\nage = 25\npi = 3.14159265\n\nf\"Имя: {name}, Возраст: {age}\""
    },
    {
      "type": "heading",
      "level": 3,
      "content": ".format() — старый способ (встречается в коде)"
    },
    {
      "type": "code",
      "language": "python",
      "content": "\"Имя: {}, Возраст: {}\".format(name, age)\n\"Имя: {0}, Возраст: {1}\".format(name, age)\n\"Имя: {name}, Возраст: {age}\".format(name=name, age=age)\n\"Pi = {pi:.2f}\".format(pi=pi)"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "% — устаревший (C-style)"
    },
    {
      "type": "code",
      "language": "python",
      "content": "\"Имя: %s, Возраст: %d\" % (name, age)\n\"Pi = %.2f\" % pi"
    },

      "content": "3. Сортировка"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "sorted() vs list.sort()"
    },
    {
      "type": "code",
      "language": "python",
      "content": "lst = [3, 1, 4, 1, 5]\n\nsorted(lst)        # [1, 1, 3, 4, 5] — НОВЫЙ список\nlst.sort()         # lst изменён на месте, возвращает None"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "key-функция — КЛЮЧ к эффективной сортировке"
    },
    {
      "type": "code",
      "language": "python",
      "content": "words = [\"apple\", \"pie\", \"banana\", \"a\"]\n\nsorted(words, key=len)           # ['a', 'pie', 'apple', 'banana']\nsorted(words, key=len, reverse=True)  # ['banana', 'apple', 'pie', 'a']\n"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "itemgetter, attrgetter, methodcaller"
    },
    {
      "type": "code",
      "language": "python",
      "content": "from operator import itemgetter, attrgetter, methodcaller\n\nusers = [{\"name\": \"Анна\", \"age\": 25}, {\"name\": \"Борис\", \"age\": 20}]\nsorted(users, key=itemgetter(\"age\"))  # быстрее lambda\n\nclass User:\n    def __init__(self, name, age):\n        self.name, self.age = name, age\n\nusers_obj = [User(\"Анна\", 25), User(\"Борис\", 20)]\nsorted(users_obj, key=attrgetter(\"age\"))"
    },

      "content": "from collections import defaultdict\n"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "ChainMap — объединение словарей (поиск по цепочке)"
    },
    {
      "type": "code",
      "language": "python",
      "content": "from collections import ChainMap\n\ndefaults = {\"color\": \"blue\", \"size\": 10}\nuser_prefs = {\"size\": 12}\nenv = {\"color\": \"red\"}\n\nconfig = ChainMap(env, user_prefs, defaults)\nconfig[\"color\"]   # \"red\" (env)\nconfig[\"size\"]    # 12 (user_prefs)\nconfig[\"font\"]    # KeyError (нет в defaults)\n"
    },

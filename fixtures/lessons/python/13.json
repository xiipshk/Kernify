    },
    {
      "type": "heading",
      "level": 3,
      "content": "namedtuple — лёгкие неизменяемые записи"
    },
    {
      "type": "code",
      "language": "python",
      "content": "from collections import namedtuple\n\nPoint = namedtuple(\"Point\", [\"x\", \"y\"])\np = Point(1, 2)\np.x, p.y        # 1, 2\np[0], p[1]      # 1, 2 (как кортеж)\nx, y = p        # распаковка\n"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "dataclass (современная альтернатива, Python 3.7+)"
    },
    {
      "type": "code",
      "language": "python",
      "content": "from dataclasses import dataclass\n\n@dataclass\nclass Point:\n    x: float\n    y: float\n    label: str = \"point\"  # значение по умолчанию"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "deque — двусторонняя очередь (O(1) с обеих сторон)"
    },
    {
      "type": "code",
      "language": "python",
      "content": "from collections import deque\n\ndq = deque([1, 2, 3])\ndq.append(4)       # справа\ndq.appendleft(0)   # слева\ndq.pop()           # 4\ndq.popleft()       # 0\n"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Counter — подсчёт элементов"
    },
    {
      "type": "code",
      "language": "python",
      "content": "from collections import Counter\n\ncnt = Counter(\"abracadabra\")"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "defaultdict — словарь с фабрикой значений"
    },
    {
      "type": "code",

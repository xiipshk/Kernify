    {
      "type": "heading",
      "level": 2,
      "content": "1. Списки (list) — изменяемые, упорядоченные, допускают дубликаты"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Создание"
    },
    {
      "type": "code",
      "language": "python",
      "content": "lst = [1, 2, 3]\nempty = []\nmixed = [1, \"текст\", 3.14, True, [1, 2]]\nfrom_list = list(\"abc\")     # ['a', 'b', 'c']\nfrom_range = list(range(5)) # [0, 1, 2, 3, 4]"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Чтение"
    },
    {
      "type": "code",
      "language": "python",
      "content": "lst = [\"а\", \"б\", \"в\", \"г\", \"д\"]\nlst[0]        # \"а\" (первый)\nlst[-1]       # \"д\" (последний)\nlst[1:4]      # [\"б\", \"в\", \"г\"] (срез: от 1 включительно до 4 исключительно)\nlst[:3]       # [\"а\", \"б\", \"в\"]\nlst[2:]       # [\"в\", \"г\", \"д\"]\nlst[::2]      # [\"а\", \"в\", \"д\"] (шаг 2)\nlst[::-1]     # [\"д\", \"г\", \"в\", \"б\", \"а\"] (реверс)"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Изменение"
    },
    {
      "type": "code",
      "language": "python",
      "content": "lst = [1, 2, 3]\nlst[0] = 10          # [10, 2, 3]\nlst[1:3] = [20, 30]  # [10, 20, 30]\nlst.append(4)        # [10, 20, 30, 4] — в конец\nlst.insert(1, 15)    # [10, 15, 20, 30, 4] — по индексу\nlst.extend([5, 6])   # [10, 15, 20, 30, 4, 5, 6] — несколько\nlst += [7, 8]        # то же что extend"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Удаление"
    },
    {
      "type": "code",
      "language": "python",
      "content": "lst = [1, 2, 3, 2, 4]\nlst.remove(2)        # удаляет ПЕРВОЕ вхождение → [1, 3, 2, 4]\npopped = lst.pop()   # удаляет ПОСЛЕДНИЙ, возвращает его → 4, lst=[1, 3, 2]\npopped = lst.pop(0)  # удаляет по индексу → 1, lst=[3, 2]\ndel lst[0]           # удаляет по индексу, не возвращает → lst=[2]\nlst.clear()          # [] — очистка"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Другие методы"
    },
    {
      "type": "code",
      "language": "python",
      "content": "lst = [3, 1, 4, 1, 5]\nlst.index(4)         # 2 (индекс первого вхождения)\nlst.count(1)         # 2 (сколько раз встречается)\nlst.sort()           # [1, 1, 3, 4, 5] — на месте!\nsorted_lst = sorted(lst, reverse=True)  # [5, 4, 3, 1, 1] — новый список\nlst.reverse()        # на месте\nlen(lst)             # 5"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Копирование — важно!"
    },
    {
      "type": "code",
      "language": "python",
      "content": "original = [1, 2, [3, 4]]\n"
    },
    {

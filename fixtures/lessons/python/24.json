    },
    {
      "type": "code",
      "language": "cython",
      "content": ""
    },
    {
      "type": "heading",
      "level": 3,
      "content": "memoryview — быстрый доступ к буферам"
    },
    {
      "type": "code",
      "language": "cython",
      "content": "def sum_buffer(int[:] buf):\n    cdef int total = 0\n    cdef int i\n    for i in range(buf.shape[0]):\n        total += buf[i]\n    return total\n"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "nogil — освобождение GIL"
    },
    {
      "type": "code",
      "language": "cython",
      "content": "from cython.parallel import prange\n\ndef parallel_sum(int[:] data):\n    cdef int total = 0\n    cdef int i\n    for i in prange(data.shape[0], nogil=True):\n        total += data[i]\n    return total"
    },
    {
      "type": "heading",
      "level": 2,
      "content": "4. ctypes — встроенный FFI"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Загрузка библиотеки"
    },
    {
      "type": "code",
      "language": "python",
      "content": "import ctypes\nimport platform\n\nif platform.system() == \"Windows\":\n    lib = ctypes.CDLL(\"./mylib.dll\")\nelse:\n    lib = ctypes.CDLL(\"./mylib.so\")\n"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Структуры"
    },
    {
      "type": "code",
      "language": "python",
      "content": "class Point(ctypes.Structure):\n    _fields_ = [(\"x\", ctypes.c_double), (\"y\", ctypes.c_double)]\n\nlib.distance.argtypes = [ctypes.POINTER(Point), ctypes.POINTER(Point)]\nlib.distance.restype = ctypes.c_double\n\np1 = Point(0, 0)\np2 = Point(3, 4)\nprint(lib.distance(ctypes.byref(p1), ctypes.byref(p2)))  # 5.0"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Callback функции"
    },
    {
      "type": "code",
      "language": "python",
      "content": "CMPFUNC = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.c_int)\n\ndef py_compare(a, b):\n    return a - b\n\ncmp_func = CMPFUNC(py_compare)\nlib.qsort(array, len(array), ctypes.sizeof(ctypes.c_int), cmp_func)"
    },
    {
      "type": "heading",
      "level": 2,
      "content": "5. cffi — удобный FFI"

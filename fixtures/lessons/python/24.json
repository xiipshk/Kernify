    {
      "type": "code",
      "language": "python",
      "content": "from cffi import FFI\n\nffi = FFI()\nffi.cdef(\"\"\"\n    int add(int a, int b);\n    double distance(double x1, double y1, double x2, double y2);\n\"\"\")\n\nlib = ffi.dlopen(\"./mylib.so\")  # или .dll/.dylib\nprint(lib.add(2, 3))"
    },

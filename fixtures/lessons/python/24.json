    {
      "type": "heading",
      "level": 2,
      "content": "6. PyO3 — Rust + Python"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Установка"
    },
    {
      "type": "code",
      "language": "bash",
      "content": "pip install maturin"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Структура проекта"
    },
    {
      "type": "code",
      "language": "bash",
      "content": "maturin new --bindings pyo3 my_rust_lib\ncd my_rust_lib"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Cargo.toml"
    },
    {
      "type": "code",
      "language": "toml",
      "content": "[package]\nname = \"my_rust_lib\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\nname = \"my_rust_lib\"\ncrate-type = [\"cdylib\"]\n\n[dependencies]\npyo3 = { version = \"0.20\", features = [\"extension-module\"] }"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Rust код"
    },
    {
      "type": "code",
      "language": "rust",
      "content": "// src/lib.rs\nuse pyo3::prelude::*;\n\n#[pyfunction]\nfn fib(n: usize) -> usize {\n    let mut a = 0;\n    let mut b = 1;\n    for _ in 0..n {\n        let tmp = a + b;\n        a = b;\n        b = tmp;\n    }\n    a\n}\n\n#[pymodule]\nfn my_rust_lib(m: &Bound<'_, PyModule>) -> PyResult<()> {\n    m.add_function(wrap_pyfunction!(fib, m)?)?;\n    Ok(())\n}"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Сборка и использование"
    },
    {
      "type": "code",
      "language": "bash",
      "content": "maturin develop --release"
    },
    {
      "type": "code",
      "language": "python",
      "content": "import my_rust_lib\nprint(my_rust_lib.fib(10))  # 55"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Параллелизм без GIL"
    },
    {
      "type": "code",
      "language": "rust",
      "content": "use pyo3::prelude::*;\nuse rayon::prelude::*;\n\n#[pyfunction]\nfn parallel_sum(data: Vec<usize>) -> usize {\n    data.par_iter().sum()  // Rayon использует все ядра!\n}"
    },
    {
      "type": "heading",
      "level": 2,
      "content": "7. Numba — JIT компиляция"
    },
    {
      "type": "code",
      "language": "bash",
      "content": "pip install numba"
    },
    {
      "type": "code",
      "language": "python",
      "content": "from numba import jit, prange\nimport numpy as np\n\n@jit(nopython=True)\ndef fast_fib(n):\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, a + b\n    return a\n\n@jit(nopython=True, parallel=True)\ndef parallel_sum(arr):\n    total = 0\n    for i in prange(arr.shape[0]):\n        total += arr[i]\n    return total\n\narr = np.arange(10_000_000)\nprint(parallel_sum(arr))"
    },

      "type": "heading",
      "level": 3,
      "content": "Минимальное расширение"
    },
    {
      "type": "code",
      "language": "c",
      "content": "// mymodule.c\n#include <Python.h>\n\nstatic PyObject* hello(PyObject* self, PyObject* args) {\n    const char* name;\n    if (!PyArg_ParseTuple(args, \"s\", &name))\n        return NULL;\n    return PyUnicode_FromFormat(\"Hello, %s!\", name);\n}\n\nstatic PyMethodDef methods[] = {\n    {\"hello\", hello, METH_VARARGS, \"Greet someone\"},\n    {NULL, NULL, 0, NULL}\n};\n\nstatic struct PyModuleDef module = {\n    PyModuleDef_HEAD_INIT,\n    \"mymodule\",\n    \"Example module\",\n    -1,\n    methods\n};\n\nPyMODINIT_FUNC PyInit_mymodule(void) {\n    return PyModule_Create(&module);\n}"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Компиляция (setup.py)"
    },
    {
      "type": "code",
      "language": "python",
      "content": ""
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Использование"
    },
    {
      "type": "code",
      "language": "python",
      "content": "import mymodule\nprint(mymodule.hello(\"World\"))  # Hello, World!"
    },

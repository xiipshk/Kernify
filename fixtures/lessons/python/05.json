    {
      "type": "code",
      "language": "python",
      "content": "import random\n\nsecret = random.randint(1, 100)\nattempts = 0\nmax_attempts = 7\n\nprint(\"Угадай число от 1 до 100!\")\n\nwhile attempts < max_attempts:\n    guess = int(input(f\"Попытка {attempts + 1}: \"))\n    attempts += 1\n\n    if guess == secret:\n        print(f\"Поздравляю! Угадал за {attempts} попыток!\")\n        break\n    elif guess < secret:\n        print(\"Больше!\")\n    else:\n        print(\"Меньше!\")\nelse:\n    print(f\"Попытки закончились. Число было: {secret}\")"

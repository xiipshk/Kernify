    {
      "type": "heading",
      "level": 3,
      "content": "`xtask` паттерн (встроенные задачи)"
    },
    {
      "type": "code",
      "language": "rust",
      "content": "// xtask/src/main.rs\nuse clap::{Parser, Subcommand};\n\n#[derive(Parser)]\nstruct Cli {\n    #[command(subcommand)]\n    command: Command,\n}\n\n#[derive(Subcommand)]\nenum Command {\n    /// Генерация кода\n    Codegen,\n    /// Релиз: обновление версии, тег, публикация\n    Release { version: String },\n    /// Бенчмарки с сохранением результатов\n    Bench { save: bool },\n}\n\nfn main() -> anyhow::Result<()> {\n    let cli = Cli::parse();\n    match cli.command {\n        Command::Codegen => codegen()?,\n        Command::Release { version } => release(version)?,\n        Command::Bench { save } => bench(save)?,\n    }\n    Ok(())\n}"
    },
    {
      "type": "code",
      "language": "bash",
      "content": ""
    },
    {
      "type": "heading",
      "level": 2,
      "content": "8. Build Scripts (`build.rs`)"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Базовый `build.rs`"
    },
    {
      "type": "code",
      "language": "rust",
      "content": "// build.rs\nfn main() {\n    // Пересборка при изменении файлов\n    println!(\"cargo:rerun-if-changed=src/bindings.h\");\n    println!(\"cargo:rerun-if-changed=build.rs\");\n\n    // Генерация кода\n    generate_bindings();\n\n    // Компиляция C кода\n    cc::Build::new()\n        .file(\"src/native.c\")\n        .compile(\"native\");\n\n    // Передача путей линкеру\n    println!(\"cargo:rustc-link-search=native={}\", out_dir());\n    println!(\"cargo:rustc-link-lib=static=native\");\n\n    // cfg флаги\n    println!(\"cargo:rustc-cfg=feature=\\\"my_feature\\\"\");\n\n    // Переменные окружения для рантайма\n    println!(\"cargo:rustc-env=MY_ENV=value\");\n}\n\nfn generate_bindings() {\n    let bindings = bindgen::Builder::default()\n        .header(\"src/bindings.h\")\n        .generate()\n        .expect(\"Unable to generate bindings\");\n\n    let out_path = std::path::PathBuf::from(std::env::var(\"OUT_DIR\").unwrap());\n    bindings.write_to_file(out_path.join(\"bindings.rs\")).unwrap();\n}"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Использование `OUT_DIR`"
    },
    {
      "type": "code",
      "language": "rust",
      "content": "// В коде крейта\ninclude!(concat!(env!(\"OUT_DIR\"), \"/bindings.rs\"));"
    },

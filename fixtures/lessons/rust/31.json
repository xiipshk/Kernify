    {
      "type": "heading",
      "level": 3,
      "content": "Упражнение 3: Автоматизация релиза с xtask"
    },
    {
      "type": "code",
      "language": "rust",
      "content": "// xtask/src/release.rs\nuse anyhow::Result;\nuse std::process::Command;\n\npub fn release(version: &str) -> Result<()> {\n    // 1. Обновить версии во всех Cargo.toml\n    update_versions(version)?;\n\n    // 2. Запустить тесты\n    Command::new(\"cargo\").args([\"test\", \"--workspace\"]).status()?;\n\n    // 3. Собрать релиз\n    Command::new(\"cargo\").args([\"build\", \"--workspace\", \"--release\"]).status()?;\n\n    // 4. Создать git tag\n    Command::new(\"git\").args([\"tag\", \"-a\", &format!(\"v{}\", version), \"-m\", &format!(\"Release {}\", version)]).status()?;\n\n    // 5. Push\n    Command::new(\"git\").args([\"push\", \"--tags\"]).status()?;\n\n    // 6. Публикация (по порядку зависимостей)\n    publish_order()?.iter().for_each(|crate_name| {\n        Command::new(\"cargo\").args([\"publish\", \"-p\", crate_name]).status().ok();\n    });\n\n    Ok(())\n}"
    },

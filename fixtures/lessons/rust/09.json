    },
    {
      "type": "heading",
      "level": 2,
      "content": "8. Примеры, тесты и бенчмарки"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Структура проекта"
    },
    {
      "type": "code",
      "language": "text",
      "content": "src/\n├── lib.rs\n├── main.rs\n├── bin/\n│   └── tool.rs        # Дополнительные бинарники\nexamples/\n├── simple.rs          # cargo run --example simple\ntests/\n├── integration.rs     # Интеграционные тесты\nbenches/\n├── bench.rs           # Бенчмарки (nightly)"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Интеграционные тесты (tests/)"
    },
    {
      "type": "code",
      "language": "rust",
      "content": "// tests/integration.rs\nuse my_crate::public_api;\n\n#[test]\nfn test_public_api() {\n    assert_eq!(public_api(), 42);\n}"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Примеры (examples/)"
    },
    {
      "type": "code",
      "language": "rust",
      "content": "// examples/simple.rs\nuse my_crate::Client;\n\nfn main() {\n    let client = Client::new();\n    client.do_something();\n}"
    },
    {
      "type": "code",
      "language": "bash",
      "content": "cargo run --example simple\ncargo test --example simple # Компиляция примеров как тестов"
    },

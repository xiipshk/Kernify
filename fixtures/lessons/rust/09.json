      ],
      "rows": [
        [
          "2015",
          "2015",
          "Базовая"
        ],
        [
          "2018",
          "2018",
          "NLL, модули без `mod.rs`, `try` -> `?`, `dyn Trait`"
        ],
        [
          "2021",

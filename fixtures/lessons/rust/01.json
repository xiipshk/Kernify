      ],
      "rows": [
        [
          "`cargo new <name>`",
          "Создать новый проект"
        ],
        [
          "`cargo init`",
          "Инициализировать проект в текущей папке"
        ],
        [
          "`cargo build`",
          "Собрать проект (debug)"
        ],
        [
          "`cargo build --release`",
          "Собрать оптимизированную версию"
        ],
        [
          "`cargo run`",
          "Собрать и запустить"
        ],
        [
          "`cargo check`",
          "Быстрая проверка типов без сборки бинарника"
        ],
        [
          "`cargo test`",
          "Запустить тесты"
        ],
        [
          "`cargo doc`",
          "Сгенерировать документацию"
        ],
        [
          "`cargo clean`",
          "Удалить артефакты сборки (target/)"
        ],
        [
          "`cargo update`",
          "Обновить зависимости до последних версий"
        ]
      ]
    },

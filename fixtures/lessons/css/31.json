    {
      "type": "heading",
      "level": 4,
      "content": "Особенности Sass"
    },
    {
      "type": "text",
      "content": "<strong>Вложенность (nesting):</strong>"
    },
    {
      "type": "code",
      "language": "scss",
      "content": "// SCSS\n.c-card {\n  display: flex;\n  flex-direction: column;\n\n  &__title {\n    font-size: 1.25rem;\n    font-weight: 600;\n\n    &--featured {\n      color: var(--color-primary);\n    }\n  }\n\n  &:hover {\n    box-shadow: var(--shadow-md);\n  }\n\n  @media (max-width: 768px) {\n    padding: 1rem;\n  }\n}"
    },
    {
      "type": "text",
      "content": "<strong>Переменные:</strong>"
    },
    {
      "type": "code",
      "language": "scss",
      "content": "$primary: #2563eb;\n$spacing-md: 1rem;\n$radius-md: 0.5rem;\n\n.c-btn {\n  background: $primary;\n  padding: $spacing-md;\n  border-radius: $radius-md;\n}"
    },
    {
      "type": "text",
      "content": "<strong>Миксины:</strong>"
    },
    {
      "type": "code",
      "language": "scss",
      "content": "@mixin button-base($padding: 1rem, $radius: 0.5rem) {\n  padding: $padding;\n  border-radius: $radius;\n  border: none;\n  cursor: pointer;\n  font-family: inherit;\n}\n\n.c-btn-primary {\n  @include button-base;\n  background: $primary;\n  color: white;\n}\n\n.c-btn-secondary {\n  @include button-base(0.75rem, 0.25rem);\n  background: transparent;\n  color: $primary;\n  border: 1px solid $primary;\n}"
    },
    {
      "type": "text",
      "content": "<strong>Функции:</strong>"
    },
    {
      "type": "code",
      "language": "scss",
      "content": "@function rem($px) {\n  @return $px / 16 * 1rem;\n}\n\n.c-card {\n  padding: rem(24);  // 1.5rem\n}"
    },
    {
      "type": "text",
      "content": "<strong>Директива @extend:</strong>"
    },
    {
      "type": "code",
      "language": "scss",
      "content": ".btn-base {\n  display: inline-flex;\n  align-items: center;\n  padding: 1rem;\n  border-radius: 0.5rem;\n}\n\n.btn-primary {\n  @extend .btn-base;\n  background: blue;\n  color: white;\n}"
    },
    {
      "type": "text",
      "content": "<strong>Условия и циклы:</strong>"
    },
    {
      "type": "code",
      "language": "scss",
      "content": "@each $color in (primary, secondary, danger) {\n  .btn-#{$color} {\n    background: $colors[$color];\n  }\n}\n\n@for $i from 1 through 12 {\n  .col-#{$i} {\n    width: percentage($i / 12);\n  }\n}"
    },

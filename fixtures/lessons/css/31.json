    {
      "type": "heading",
      "level": 3,
      "content": "Less"
    },
    {
      "type": "code",
      "language": "less",
      "content": "@primary: #2563eb;\n@spacing-md: 1rem;\n\n.c-btn {\n  background: @primary;\n  padding: @spacing-md;\n}\n\n.button-styles(@color) when (@color = primary) {\n  background: blue;\n}\n\n.c-btn-primary {\n  .button-styles(primary);\n}"
    },

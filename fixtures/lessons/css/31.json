      "language": "bash",
      "content": "npm install --save-dev loki"
    },
    {
      "type": "code",
      "language": "javascript",
      "content": "// .loki-config.js\nmodule.exports = {\n  projects: {\n    'my-ui': {\n      target: 'http://localhost:6006',  // Storybook\n      preset: 'react',\n      scenarios: {\n        'button.default': {\n          selector: '.c-btn--primary',\n        },\n        'button.disabled': {\n          selector: '.c-btn--primary[disabled]',\n        },\n        'card.default': {\n          selector: '.c-card',\n        },\n      },\n    },\n  },\n};"
    },
    {
      "type": "code",
      "language": "json",
      "content": "{\n  \"scripts\": {\n    \"loki:update\": \"loki update\",\n    \"loki:test\": \"loki test\",\n    \"loki:approve\": \"loki approve\"\n  }\n}"
    },

#!/bin/bash
# ============================================
# Kernify - Установка (двойной клик для запуска в Терминале)
# ============================================

# Переход в папку скрипта (на случай запуска из Finder)
cd "$(dirname "$0")"

# Запуск установки
bash install.sh

# Держим терминал открытым чтобы прочитать результат
echo ""
echo "Нажмите Enter для закрытия..."
read
#!/bin/bash
# ============================================
# Kernify - Запуск сервера (двойной клик для запуска в Терминале)
# ============================================

cd "$(dirname "$0")"

bash run.sh

# Если сервер упал — держим терминал открытым
echo ""
echo "Сервер остановлен. Нажмите Enter для закрытия..."
read